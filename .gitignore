# Legacy / accidental runtime root (never commit)
backend/

# Agent scratch, one-off patches, and local backups (never commit)
_backup_*/
_patch_*.py
_scan_*.py
_chk*.py
_fix_*.py
_s_*.txt

# Per-user installed skills live under src/data/tenants/ (ignored above).
# Bundled seed skills in src/skills are committed.
_vendor_skills/
_vendor_superpowers/

# Python
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
.pytest_cache/
tests/.scratch/
*.log

# Per-workspace codebase index
**/.sidekick/

# UI
ui/node_modules/
ui/dist/
frontend/

# Desktop (Electron)
desktop/node_modules/
desktop/dist/

