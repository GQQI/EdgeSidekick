# Preferred: configure via UI → 模型 tab, or src/data/model.json
# Env still works as bootstrap:

OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=

# Bind address — non-loopback requires META_ALLOW_REMOTE=1 (unsafe)
META_HOST=127.0.0.1
META_PORT=8787
META_DEMO_MODE=0

# Shell tool (run_shell / verify_run). Default on; still goes through approval.
# Set 0 to disable entirely.
META_ALLOW_SHELL=1
# Path-allowlist sandbox for shell/verify (cwd stays on real workspace disk)
META_SHELL_SANDBOX=1
# Discover tools from MCP servers in Settings → MCP
META_MCP_ENABLED=1

# Allow binding 0.0.0.0 / LAN (not recommended)
# META_ALLOW_REMOTE=0

# Speak/silent judge. Official Jev has no weights; point this at a self-hosted
# Kev (or another /v1/systemone server). Empty = use the chat model instead.
# SIDEKICK_SYSTEMONE_URL=http://127.0.0.1:8009
# SIDEKICK_SYSTEMONE_KEY=
# SIDEKICK_SYSTEMONE_MODEL=kev-latest
# SIDEKICK_SYSTEMONE_SPEAK_THRESHOLD=0.5
