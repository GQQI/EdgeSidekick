{
  "name": "edgesidekick-desktop",
  "private": true,
  "version": "0.3.1",
  "description": "EdgeSidekick desktop — local multi-agent workbench",
  "author": "EdgeSidekick",
  "homepage": "https://edgesidekick.local",
  "main": "main.mjs",
  "type": "module",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "dist": "electron-builder --win",
    "dist:dir": "electron-builder --win dir",
    "dist:kylin": "electron-builder --linux deb AppImage tar.gz",
    "dist:linux": "electron-builder --linux"
  },
  "devDependencies": {
    "electron": "^35.0.0",
    "electron-builder": "^26.0.12"
  }
}
